set(CMAKE_SYSTEM_NAME Windows)

set(CHROME_PLUS_ARCH "" CACHE STRING "Target architecture")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CHROME_PLUS_ARCH)

if(CHROME_PLUS_ARCH STREQUAL "x86")
  set(CHROME_PLUS_TARGET_TRIPLE i686-pc-windows-msvc)
  set(CMAKE_SYSTEM_PROCESSOR x86)
elseif(CHROME_PLUS_ARCH STREQUAL "x64")
  set(CHROME_PLUS_TARGET_TRIPLE x86_64-pc-windows-msvc)
  set(CMAKE_SYSTEM_PROCESSOR AMD64)
elseif(CHROME_PLUS_ARCH STREQUAL "arm64")
  set(CHROME_PLUS_TARGET_TRIPLE aarch64-pc-windows-msvc)
  set(CMAKE_SYSTEM_PROCESSOR ARM64)
else()
  message(FATAL_ERROR "CHROME_PLUS_ARCH must be x86, x64, or arm64.")
endif()

set(CMAKE_C_COMPILER clang-cl)
set(CMAKE_CXX_COMPILER clang-cl)
set(CMAKE_C_COMPILER_TARGET "${CHROME_PLUS_TARGET_TRIPLE}")
set(CMAKE_CXX_COMPILER_TARGET "${CHROME_PLUS_TARGET_TRIPLE}")
set(CMAKE_LINKER_TYPE LLD)
set(CMAKE_RC_COMPILER llvm-rc)
